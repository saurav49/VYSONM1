generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  HOBBY
  ENTERPRISE
  FREE
}

model UrlShortener {
  id             Int       @id @default(autoincrement())
  user           User?     @relation(fields: [userId], references: [id])
  userId         Int?
  originalUrl    String
  shortCode      String    @unique
  password       String?
  clicks         Int       @default(0)
  lastAccessedAt DateTime? @db.Timestamptz(6)
  expiryDate     DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
}

model User {
  id       Int            @id @default(autoincrement())
  email    String         @unique
  name     String?
  apiKey   String         @unique
  shortens UrlShortener[]
  tier     Tier           @default(FREE)

  file      String?
  thumbnail String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
}

model RequestLogging {
  id        Int       @id @default(autoincrement())
  method    String?
  timestamp DateTime? @default(now()) @db.Timestamptz(6)
  userAgent String?
  url       String?
  ip        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model ProcessedTask {
  taskId      String   @id
  processedAt DateTime @default(now())
  event       String
}

model ImageProcessingAggregate {
  taskId                 String    @id
  userId                 Int
  thumbnailReady         Boolean   @default(false)
  thumbnailCompletedAt   DateTime?
  safetyCheckCompleted   Boolean   @default(false)
  safetyCheckCompletedAt DateTime?
  notificationTriggered  Boolean   @default(false)
  timedOut               Boolean   @default(false)
  manualReviewTriggered  Boolean   @default(false)
  deadlineAt             DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([deadlineAt])
}

model InventoryItem {
  sku               String   @id
  availableQuantity Int
  updatedAt         DateTime @updatedAt
}

model InventoryReservation {
  eventId    String   @id
  orderId    String
  sku        String
  quantity   Int
  reservedAt DateTime @default(now())

  @@index([orderId])
}
